# Next.js Public Vars
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role (後端專用，勿曝光至前端)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# 綠界科技 ECPay
# ECPAY_STAGE=true  → 強制測試環境（可省略正式金鑰，將套用官方測試特店）
# ECPAY_STAGE=false → 強制正式環境（必須填正式 MerchantID / HashKey / HashIV）
# 未設定時：NODE_ENV!==production 自動走測試，production 走正式
ECPAY_STAGE=true
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
# 正式環境請用「全方位金流」系統介接的 Hash（勿填物流金鑰）。
# Credit 未開通時請保持預設 ALL，避免綠界回 10200074。
# ECPAY_CHOOSE_PAYMENT=ALL

# 拓維空間付款成功後，主站 callback 以此密鑰呼叫產品站 /api/credits/fulfill
# （須與 novadimension 的 CREDITS_FULFILL_SECRET 相同）
# CREDITS_FULFILL_SECRET=replace_with_long_shared_secret
# NEXT_PUBLIC_NOVA_DIMENSION_URL=https://novadimension.vercel.app

# 站台網址（本機開發 / 正式站）
# Local:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Production (permanent):
# NEXT_PUBLIC_BASE_URL=https://paycheck.com.de

# 客服／金流審核聯絡資訊（Footer & /contact）
NEXT_PUBLIC_SUPPORT_EMAIL=archer0965@gmail.com
NEXT_PUBLIC_LINE_OFFICIAL_URL=https://line.me/R/ti/p/@469uykad

# Vercel Cron → /api/keep-alive（選填；設定後請求需帶 Authorization: Bearer <secret>）
CRON_SECRET=replace_with_long_random_string

# 管理者 Email（逗號分隔；內建已含 archer0965@gmail.com）
ADMIN_EMAILS=archer0965@gmail.com

# 營運統計排除名單（管理者／測試帳號；逗號分隔）
STATS_EXCLUDE_EMAILS=archer0965@gmail.com,paycheck.demo+1791916139@gmail.com

# Resend（方案到期提醒 Email；未設定則 Cron 略過寄信，仍可寫 log）
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=對帳通 Check Pay <noreply@paycheck.com.de>
